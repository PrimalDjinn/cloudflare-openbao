{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-openbao",
  "main": "dist/index.js",
  "workers_dev": true,
  // Set this to today's date
  "compatibility_date": "2026-08-10",
  "containers": [
    {
      "class_name": "BaoContainer",
      "image": "./Dockerfile",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BaoContainer",
        "name": "BAO_CONTAINER"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "a4a8faa4-7ec0-4a2c-9db6-d28609f639a8",
      "database_name": "openbao"
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["BaoContainer"],
      "tag": "v1"
    }
  ],
  "vars": {
    "BAO_ADDR": "http://0.0.0.0:8200",
    "SKIP_SETCAP": true 
  },
  "account_id": "34c304ef4d69b760a6eabd89842033ea",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
